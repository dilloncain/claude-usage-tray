{
  "name": "claude-usage-tray",
  "productName": "Claude Usage Tray",
  "version": "1.0.1",
  "description": "Windows tray app that shows your Claude session and weekly usage limits.",
  "main": "main.js",
  "author": "Dillon Cain",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "demo": "cross-env CLAUDE_USAGE_DEMO=1 electron .",
    "test": "node --test test/lib.test.js",
    "test:e2e": "electron test/e2e.js",
    "dist": "electron-builder --win dir --x64 && node scripts/set-exe-icon.mjs && node scripts/verify-build.mjs"
  },
  "build": {
    "appId": "com.dcain.claudeusagetray",
    "productName": "Claude Usage Tray",
    "files": [
      "main.js",
      "lib.js",
      "preload.js",
      "widget.html",
      "widget.js",
      "widget.css",
      "package.json"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "artifactName": "ClaudeUsageTray-${version}-win-x64.${ext}",
    "extraFiles": [
      {
        "from": "README.txt",
        "to": "README.txt"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "asar": true
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "resedit": "^2.0.3",
    "cross-env": "^7.0.3",
    "@electron/fuses": "^1.8.0",
    "@electron/asar": "^3.2.17"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dilloncain/claude-usage-tray"
  }
}
